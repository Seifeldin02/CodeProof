{
  "name": "codeproof",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:security": "vitest run tests/security --passWithNoTests",
    "test:e2e": "playwright test tests/e2e --project=desktop-en --pass-with-no-tests",
    "test:migrations": "vitest run tests/migrations --passWithNoTests",
    "test:browser": "playwright test tests/browser --pass-with-no-tests",
    "test:vitest": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:migrations",
    "test:all": "npm run test:vitest && npm run test:e2e && npm run test:browser",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:ci": "npm run lint && npm run typecheck && npm run test:all && npm run build",
    "verify:release": "npm run verify:ci && npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "16.3.6",
    "openai": "6.48.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "yauzl": "^3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
