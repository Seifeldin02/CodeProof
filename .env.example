# No environment variables are required for the free core workflow.

# Optional AI provider. Deterministic analysis remains available without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Durable production database for accounts, candidates, requirements, and cache.
# Required on serverless/ephemeral hosts such as Vercel. Local development uses SQLite.
DATABASE_URL=
POSTGRES_URL=
CODEPROOF_CACHE_DIR=.data/analysis-cache

# Optional local candidate database location.
CODEPROOF_DB_PATH=.data/codeproof.db

# Signs session cookies. REQUIRED in production: without it each instance
# generates its own key, so sessions break across restarts and instances.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODEPROOF_SESSION_SECRET=

# Public account creation is enabled by default. Set to false only for a closed pilot.
CODEPROOF_ALLOW_SIGNUP=

# Optional server-only bootstrap. On initialization, only an already-registered
# account with this normalized email can be elevated to the internal Admin role.
ADMIN_EMAIL=

# Everything below is optional and documented in docs/ACCOUNTS.md. With none of
# it set, people sign in with an email address and a password.

# Sign-in by a 6-digit code sent by email. Set the sender and ONE provider key.
# Once codes can be delivered, passwords are no longer offered.
CODEPROOF_MAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=

# true keeps the password form beside codes; false removes it. When empty,
# passwords are offered only while no mail provider is configured.
CODEPROOF_PASSWORD_SIGN_IN=

# Google sign-in. Authorised redirect URI: https://YOUR_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Codes by text message to a mobile number the person has confirmed. Paid per
# message, so it stays off until all three are set. Needs a mail provider too.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# The address people reach this deployment at, for invitation links and the
# Google redirect. Read from the request when empty.
CODEPROOF_PUBLIC_URL=
